/* ==========================================================================
   IMAN Terra - tema institucional (QSS). Opcao 1, no-fork.
   Aplicado (anexado) a janela principal pelo startup (iman_startup.py). Recolore
   a "chrome" da UI Qt (menus, toolbars, headers, selecao, abas, botoes) no verde
   IMAN, MANTENDO areas de conteudo (arvore de camadas, tabelas) claras p/ legibilidade.
   Limite honesto: NAO troca os icones de ACAO da toolbar do QGIS (core C++).
   Paleta ATIVA (redesign D-IMAN-026, INTERIM) - fonte unica: brand.py /
   docs/design-system.md / spike/003 tokens.py (BL-4). Promovida na fatia #005:
     brand #103D29 | brand-2 #1E7A4D | accent #2B8FD6 | moss #6E9160 | earth #8A7A55
     bg #EBEEE8 | panel #FFFFFF | panel-2 #F5F7F2 | border #E2E5DE | text #1A231D
     hover #EFF2EC | active-bg #E4F0E8 | active-fg #155F3D | chrome-fg #EAF3EC
   ========================================================================== */

/* ---- Barra de menus superior (chrome) ---- */
QMenuBar {
    background-color: #103D29;
    color: #EAF3EC;
    border: none;
}
QMenuBar::item { background: transparent; padding: 5px 11px; }
QMenuBar::item:selected { background-color: #1E7A4D; color: #FFFFFF; }
QMenuBar::item:pressed { background-color: #1E7A4D; color: #FFFFFF; }

/* ---- Menus abertos ---- */
QMenu {
    background-color: #FFFFFF;
    color: #1A231D;
    border: 1px solid #1E7A4D;
}
QMenu::item { padding: 5px 24px 5px 22px; }
QMenu::item:selected { background-color: #1E7A4D; color: #FFFFFF; }
QMenu::separator { height: 1px; background: #E2E5DE; margin: 4px 8px; }

/* ---- Toolbars (fundo claro neutro; icones do QGIS ficam legiveis) ---- */
QToolBar {
    background-color: #F5F7F2;
    border: none;
    border-bottom: 1px solid #E2E5DE;
    spacing: 2px;
    padding: 2px;
}
QToolBar::separator { background: #E2E5DE; width: 1px; margin: 3px 4px; }
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px;
}
QToolButton:hover { background-color: #EFF2EC; border: 1px solid #1E7A4D; }
QToolButton:checked, QToolButton:pressed {
    background-color: #E4F0E8; border: 1px solid #103D29;
}
QToolButton::menu-button { border: none; }

/* ---- Status bar ---- */
QStatusBar { background-color: #F5F7F2; color: #103D29; }
QStatusBar::item { border: none; }

/* ---- Docks / paineis ---- */
QDockWidget { titlebar-close-icon: none; }
QDockWidget::title {
    background-color: #103D29;
    color: #EAF3EC;
    padding: 5px 8px;
    font-weight: 600;
}
QDockWidget > QWidget { background-color: #FFFFFF; }

/* ---- Arvore/lista (camadas, navegador): conteudo CLARO, selecao verde ---- */
QTreeView, QListView, QTableView {
    background-color: #FFFFFF;
    color: #1A231D;
    alternate-background-color: #F5F7F2;
    selection-background-color: #1E7A4D;
    selection-color: #FFFFFF;
}
QTreeView::item:hover, QListView::item:hover { background-color: #EFF2EC; }
QTreeView::item:selected, QListView::item:selected {
    background-color: #1E7A4D; color: #FFFFFF;
}
QHeaderView::section {
    background-color: #103D29;
    color: #EAF3EC;
    padding: 4px 6px;
    border: none;
    border-right: 1px solid #1E7A4D;
}

/* ---- Abas ---- */
QTabBar::tab {
    background: #F5F7F2;
    color: #1A231D;
    padding: 5px 12px;
    border: 1px solid #E2E5DE;
    border-bottom: none;
}
QTabBar::tab:selected {
    background: #FFFFFF;
    color: #103D29;
    border-bottom: 2px solid #1E7A4D;
    font-weight: 600;
}
QTabBar::tab:hover { background: #E4F0E8; }

/* ---- Botoes padrao ---- */
QPushButton {
    background-color: #FFFFFF;
    color: #103D29;
    border: 1px solid #1E7A4D;
    border-radius: 5px;
    padding: 4px 12px;
}
QPushButton:hover { background-color: #EFF2EC; }
QPushButton:pressed { background-color: #E4F0E8; }
QPushButton:default { background-color: #1E7A4D; color: #FFFFFF; border: 1px solid #103D29; }
QPushButton:default:hover { background-color: #103D29; }

/* ---- GroupBox ---- */
QGroupBox {
    border: 1px solid #E2E5DE;
    border-radius: 5px;
    margin-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    color: #103D29;
    font-weight: 600;
}

/* ---- Scrollbars discretas ---- */
QScrollBar:vertical { background: #F5F7F2; width: 12px; margin: 0; }
QScrollBar::handle:vertical { background: #C6D3C2; border-radius: 5px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #1E7A4D; }
QScrollBar:horizontal { background: #F5F7F2; height: 12px; margin: 0; }
QScrollBar::handle:horizontal { background: #C6D3C2; border-radius: 5px; min-width: 24px; }
QScrollBar::handle:horizontal:hover { background: #1E7A4D; }
QScrollBar::add-line, QScrollBar::sub-line { background: none; border: none; }
