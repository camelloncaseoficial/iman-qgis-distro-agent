# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Tests / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# QGIS / compiled resources
*.qgz~
*.qgs~
resources_rc.py

# Instalador / build (artefatos gerados)
# O .exe NAO entra no repo; o BUILD_INFO.txt ENTRA — ele é a procedência do
# artefato (commit + versão + SHA-256) e sem ele o BL-7 não é auditável.
# Precisa ser "dist/*" e não "dist/": git não reabre um diretório já excluído.
installer/dist/*
!installer/dist/BUILD_INFO.txt
installer/Output/
*.exe
/dist/
/build/

# Dependências pesadas empacotadas (não versionar binários grandes)
app/dependencies/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Drop bruto do redesign (sponsor) - fontes leves versionadas a parte; brutos nao
docs/# IMAN Terra Interface Redesign.zip
docs/ChatGPT Image*.png
docs/uploads/
docs/.thumbnail

# Binario QGIS patchado do spike #004 (nao versionar binario GPL modificado)
spike/**/dist/
