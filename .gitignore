# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Tests / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# QGIS / compiled resources
*.qgz~
*.qgs~
resources_rc.py

# Payload do QGIS embarcado no instalador (D-IMAN-028/DB-5)
# ~541 MB de binario oficial NAO entram num repo de poucos MB - seria
# irreversivel. O installer\build.ps1 estagia o MSI aqui em tempo de build e
# confere o SHA-256 antes de compilar.
installer/payload/

# Instalador / build (artefatos gerados)
# Nenhum .exe entra no repo. Desde a #029 (DB-25) o registro depende de quem
# compilou:
#   - build de BRANCH: installer/dist/nao-canonico/<id>/ (o .exe e o
#     BUILD_INFO.txt dele), tudo fora do git;
#   - build CANONICO : installer/canonico/<versao>-<commit>/BUILD_INFO.txt e
#     installer/canonico/VIGENTE.txt ENTRAM. Sao a procedencia do candidato a
#     release (commit + versao + SHA-256), e sem eles o BL-7 nao e auditavel.
#     O .exe ao lado fica fora (regra explicita abaixo, alem do *.exe global).
installer/dist/
installer/canonico/**/*.exe
installer/Output/
*.exe
/dist/
/build/

# Dependências pesadas empacotadas (não versionar binários grandes)
app/dependencies/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Drop bruto do redesign (sponsor) - fontes leves versionadas a parte; brutos nao
docs/# IMAN Terra Interface Redesign.zip
docs/ChatGPT Image*.png
docs/uploads/
docs/.thumbnail

# Binario QGIS patchado do spike #004 (nao versionar binario GPL modificado)
spike/**/dist/

# SPIKE #016 - diretorio de trabalho do spike: guarda o log do msiexec (86 MB)
# e os manifestos completos de footprint (~6 MB cada). A evidencia CURADA e
# versionada vive em docs/verify/016-spike-qgis-relocado/evidencia/.
tools/spike016/evidencia/

# Gate #018 - saida das rodadas de adulteracao inversa (regeravel)
tools/adulteracao/

# Arvore privada do QGIS montada em tempo de build (fatia #019, via A1).
# ~2,2 GB extraidos do payload; regeravel com installer\New-ArvoreQgis.ps1.
installer/stage/
