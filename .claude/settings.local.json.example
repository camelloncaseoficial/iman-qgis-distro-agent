{
  "permissions": {
    "allow": [
      "Bash(bash ../iman-product-architect/.claude/crew-hooks/crew_gate.sh *)"
    ],
    "deny": [
      "Edit(.github/**)",
      "Edit(**/CODEOWNERS)",
      "Edit(.git/**)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/compose.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)"
    ]
  },
  "remoteControlAtStartup": false,
  "autoUploadSessions": false,
  "crossSessionInbound": "refuse",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/../iman-product-architect/.claude/crew-hooks/crew_guard.sh\""
          }
        ]
      }
    ]
  }
}
